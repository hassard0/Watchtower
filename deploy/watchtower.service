[Unit]
Description=Watchtower RF perimeter awareness daemon
After=bluetooth.service NetworkManager.service bt-hci1-up.service
Wants=bluetooth.service NetworkManager.service
# If the bluetooth daemon dies, restart watchtower along with it so the BLE scanner can re-attach.
PartOf=bluetooth.service
# Hardware and network readiness can lag at boot. Never permanently give up
# because a transient USB/Bluetooth failure exhausted a short retry window.
StartLimitIntervalSec=0

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/opt/watchtower
ExecStart=/opt/watchtower/.venv/bin/watchtower run --config /etc/watchtower/watchtower.toml
Restart=always
RestartSec=15
# After a longer outage (boot too early, etc.), wait up to 60s for bluetoothd to settle.
TimeoutStartSec=60s
TimeoutStopSec=30s
StandardOutput=append:/var/log/watchtower/watchtower.log
StandardError=append:/var/log/watchtower/watchtower.err

# Security hardening (loosened for hardware access).
# NoNewPrivileges must be false so AmbientCapabilities can grant CAP_NET_ADMIN
# (needed for `iw dev wlan0 scan` from the WifiScanner).
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
# Bluetooth + USB SDR access requires non-restricted device groups.
SupplementaryGroups=bluetooth plugdev netdev

[Install]
WantedBy=multi-user.target
